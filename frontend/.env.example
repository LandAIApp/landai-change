# URL of the backend API as seen from the BROWSER.
VITE_API_BASE_URL=http://localhost:8000
# "Talk to Land AI" button target (leave empty to hide the button).
VITE_LANDAI_CONTACT_URL=
# Only for GitHub Pages project sites, e.g. /landai-change/ (leave empty locally).
VITE_BASE_PATH=
# Optional basemap override (default: OpenStreetMap standard tiles; fine for a low-traffic beta).
VITE_BASEMAP_URL=
VITE_BASEMAP_ATTRIBUTION=
