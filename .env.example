# ---- Backend (copiar a .env en la raíz del repo; NO subir .env a git) ----
# Proyecto de Google Cloud registrado en Earth Engine (obligatorio)
EE_PROJECT=tu-proyecto-gcp
# Colección de municipios (la misma de Wildfire)
MUNICIPALITIES_ASSET=users/maikolzaraza07/mpios

# Orígenes permitidos por CORS (solo origen, sin ruta), separados por coma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Límites de la versión beta gratuita ----
MAX_AOI_HECTARES=100000
WARN_AOI_HECTARES=50000
MIN_AOI_HECTARES=10
MAX_POLYGON_VERTICES=300
MAX_CONCURRENT_ANALYSES=1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE=5/hour;20/day
# En Cloud Run poner true (lee la IP real desde X-Forwarded-For)
TRUST_FORWARDED_FOR=false
TRUSTED_PROXY_HOPS=1
LOG_LEVEL=INFO

# ---- Credenciales ----
# Local:      ejecutar `earthengine authenticate` (no hace falta ninguna variable más).
# Cloud Run:  identidad de servicio (sin llaves JSON).
# Opcional (solo desarrollo, NUNCA en git): ruta a una llave de cuenta de servicio.
# EE_PRIVATE_KEY_PATH=
# EE_SERVICE_ACCOUNT=
